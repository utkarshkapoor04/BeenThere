# Add these in Vercel → Project → Settings → Environment Variables
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key   # NOT the service_role / secret key
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop              # 16 letters, no spaces
OWNER_EMAIL=you@gmail.com                        # where notifications go (optional, defaults to GMAIL_USER)
